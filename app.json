{
  "expo": {
    "name": "Veloracia",
    "slug": "veloracia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1010"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Приложению необходим доступ к микрофону для записи голосовых сообщений",
        "NSLocationWhenInUseUsageDescription": "Приложению необходим доступ к геолокации для отображения вашей позиции на карте"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1010"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.wladislove.velorazdemo",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "37f07118-7e48-4628-87d5-35110b132497"
      }
    },
    "plugins": [
      "expo-location",
      "expo-audio",
      "expo-asset",
      "expo-font"
    ]
  }
}
