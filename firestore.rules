rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsMessage() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /radioMessages/{messageId} {
      allow read: if signedIn();
      allow create: if ownsMessage()
        && request.resource.data.keys().hasOnly([
          'userId', 'nickname', 'avatar', 'audioUrl', 'audioPath', 'mimeType', 'location', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.audioPath.matches('radioMessages/' + request.auth.uid + '/.*')
        && (request.resource.data.location == null || request.resource.data.location is map)
        && request.resource.data.nickname.size() <= 20;
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /radioQueue/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'nickname', 'avatar', 'location', 'joinedAt'])
        && request.resource.data.joinedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
